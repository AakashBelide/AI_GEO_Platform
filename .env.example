# ─────────────────────────────────────────────────────────────
# AI_GEO Platform — environment template
# Copy this file to `.env` and fill in real values.
# `.env` and `secrets/` are gitignored and MUST NEVER be committed.
# Do NOT paste real keys into chat, commits, or any tracked file.
# ─────────────────────────────────────────────────────────────

# --- Answer-engine API keys (needed for the citation-tracker POCs) ---
OPENAI_API_KEY=sk-your-openai-key-here
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here
GEMINI_API_KEY=your-gemini-key-here
# Optional 4th engine (stretch):
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Model / version pins (for reproducibility; override as needed) ---
OPENAI_MODEL=gpt-5
PERPLEXITY_MODEL=sonar
GEMINI_MODEL=gemini-3-flash
ANTHROPIC_MODEL=claude-sonnet-5

# --- Measurement defaults ---
DEFAULT_TEMPERATURE=0
DEFAULT_REPEATS=5
# Hard per-provider spend cap for LIVE runs (dry-run spends nothing).
BUDGET_USD_PER_PROVIDER=2.00

# --- Web app (Docker) ---
# Backend (FastAPI): where the run/report index DB lives, and which browser origin may call it.
GEO_APP_DB=data/app.db
GEO_CORS_ORIGINS=http://localhost:3000
# Frontend (Next.js): the API base the BROWSER calls (host-mapped port). Inlined at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Local storage ---
DATABASE_URL=sqlite:///data/geo.sqlite3

# --- Crawler POC (7.3) safety knobs ---
# Only crawl scrape-safe sandbox targets. Respect robots.txt. Rate-limit.
CRAWLER_TARGET=https://books.toscrape.com
CRAWLER_MAX_PAGES=25
CRAWLER_DELAY_SECONDS=1.5
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USER_AGENT=AI_GEO_Research_Bot/0.1 (local; contact via repo owner)
